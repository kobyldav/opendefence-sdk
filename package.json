{
  "name": "opendefence-sdk-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test:compiled": "node --test tests/*.test.mjs",
    "test": "npm run build && npm run test:compiled",
    "check": "npm run clean && npm run build && npm run test:compiled",
    "pack:check": "npm pack --dry-run --workspace @opendefence/sdk",
    "example": "node examples/integrated.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
